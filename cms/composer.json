{
	"$schema": "https://getcomposer.org/schema.json",
	"name": "laravel/laravel",
	"type": "project",
	"description": "The skeleton application for the Laravel framework.",
	"keywords": [
		"laravel",
		"framework"
	],
	"license": "MIT",
	"require": {
		"php": "^8.3",
		"laravel/framework": "^13.17",
		"laravel/sanctum": "^4.4",
		"laravel/tinker": "^3.0",
		"mongodb/laravel-mongodb": "^5.12",
		"predis/predis": "^3.8"
	},
	"require-dev": {
		"dooh/module-core": "^1.0.0",
		"dooh/module-auth": "^1.0.0",
		"dooh/module-creative": "^1.0.0",
		"dooh/module-delivery": "^1.0.0",
		"dooh/module-log": "^1.0.0",
		"dooh/module-report": "^1.0.0",
		"dooh/module-simulator": "^1.0.0",
		"dooh/module-user": "^1.0.0",
		"dooh/module-venue": "^1.0.0",
		"fakerphp/faker": "^1.23",
		"laravel/pail": "^1.2.5",
		"laravel/pao": "^1.0.6",
		"laravel/pint": "^1.27",
		"mockery/mockery": "^1.6",
		"nunomaduro/collision": "^8.6",
		"phpunit/phpunit": "^12.5.12"
	},
	"autoload": {
		"psr-4": {
			"App\\": "app/",
			"Modules\\Core\\": "modules/Core/src/",
			"Modules\\Venue\\": "modules/Venue/src/",
			"Modules\\Delivery\\": "modules/Delivery/src/",
			"Modules\\Creative\\": "modules/Creative/src/",
			"Modules\\Log\\": "modules/Log/src/",
			"Modules\\Report\\": "modules/Report/src/",
			"Modules\\Simulator\\": "modules/Simulator/src/",
			"Modules\\Auth\\": "modules/Auth/src/",
			"Modules\\User\\": "modules/User/src/",
			"Modules\\Vendor\\": "modules/Vendor/src/",
			"Modules\\User\\Database\\Seeders\\": "modules/User/database/seeders/",
			"Modules\\Venue\\Database\\Seeders\\": "modules/Venue/database/seeders/",
			"Modules\\Creative\\Database\\Seeders\\": "modules/Creative/database/seeders/",
			"Modules\\Vendor\\Database\\Seeders\\": "modules/Vendor/database/seeders/",
			"Database\\Seeders\\": "database/seeders/"
		}
	},
	"repositories": [
		{
			"type": "path",
			"url": "modules/*",
			"options": {
				"symlink": true
			}
		}
	],
	"autoload-dev": {
		"psr-4": {
			"Tests\\": "tests/",
			"Modules\\Venue\\Tests\\": "modules/Venue/tests/",
			"Modules\\Core\\Tests\\": "modules/Core/tests/",
			"Modules\\Delivery\\Tests\\": "modules/Delivery/tests/",
			"Modules\\Creative\\Tests\\": "modules/Creative/tests/",
			"Modules\\Simulator\\Tests\\": "modules/Simulator/tests/",
			"Modules\\Report\\Tests\\": "modules/Report/tests/",
			"Modules\\Log\\Tests\\": "modules/Log/tests/",
			"Modules\\Auth\\Tests\\": "modules/Auth/tests/",
			"Modules\\User\\Tests\\": "modules/User/tests/"
		}
	},
	"scripts": {
		"setup": [
			"composer install",
			"@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
			"@php artisan key:generate",
			"@php artisan migrate --force",
			"npm install --ignore-scripts",
			"npm run mix"
		],
		"dev": [
			"Composer\\Config::disableProcessTimeout",
			"@php artisan dev"
		],
		"test": [
			"@php artisan config:clear --ansi @no_additional_args",
			"@php artisan test"
		],
		"post-autoload-dump": [
			"Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
			"@php artisan package:discover --ansi"
		],
		"post-update-cmd": [
			"@php artisan vendor:publish --tag=laravel-assets --ansi --force"
		],
		"post-root-package-install": [
			"@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
		],
		"post-create-project-cmd": [
			"@php artisan key:generate --ansi",
			"@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
			"@php artisan migrate --graceful --ansi"
		],
		"pre-package-uninstall": [
			"Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
		]
	},
	"extra": {
		"laravel": {
			"dont-discover": []
		}
	},
	"config": {
		"optimize-autoloader": true,
		"preferred-install": "dist",
		"sort-packages": true,
		"allow-plugins": {
			"pestphp/pest-plugin": true,
			"php-http/discovery": true
		}
	},
	"minimum-stability": "stable",
	"prefer-stable": true
}
