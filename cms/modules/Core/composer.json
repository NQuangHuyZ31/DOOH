{
	"name": "dooh/module-core",
	"description": "Core foundation module for DOOH CMS",
	"type": "library",
	"version": "1.0.0",
	"license": "proprietary",
	"authors": [
		{
			"name": "DOOH"
		}
	],
	"require": {
		"php": "^8.3",
		"illuminate/support": "^11.0|^12.0|^13.0"
	},
	"autoload": {
		"psr-4": {
			"Modules\\Core\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Modules\\Core\\Tests\\": "tests/"
		}
	},
	"extra": {
		"laravel": {
			"providers": [
				"Modules\\Core\\Providers\\CoreServiceProvider"
			]
		}
	}
}
