APP_NAME="DOOH CMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Relational Core (MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dooh_cms
DB_USERNAME=root
DB_PASSWORD=root

# Log & Aggregated Stats (MongoDB)
MONGODB_CONNECTION=mongodb
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DATABASE=dooh_tracking_db
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Cache, Invalidation & Buffer (Redis)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

FILESYSTEM_DISK=public
SESSION_DRIVER=file
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Auth & Email OTP Settings
AUTH_EMAIL_OTP_ENABLED=false
AUTH_EMAIL_OTP_TTL_MINUTES=5

