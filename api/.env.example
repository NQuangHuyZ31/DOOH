# Node Tracking API Environment Variables
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
API_PREFIX=/api/v1

# Security: 32-byte hex key for AES-256-GCM token encryption & Screen HMAC verification
APP_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SCREEN_MASTER_SECRET=
HMAC_MAX_SKEW_SECONDS=300

# Redis Configuration (Deduplication, Buffering & Playlist Cache)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MongoDB Configuration (Proof of Play & Historical Log Archive)
MONGODB_URI=mongodb://127.0.0.1:27017/dooh_tracking
MONGODB_DB=dooh_tracking

# CORS Settings
ALLOWED_ORIGINS=*

# Internal CMS Fallback (Cache-Miss Warm-up)
CMS_BASE_URL=
CMS_INTERNAL_PREFIX=/admin/api/internal
CMS_INTERNAL_SECRET=
CMS_TIMEOUT_MS=3000
