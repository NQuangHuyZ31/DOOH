{
	"name": "dooh-tracking-api",
	"version": "1.0.0",
	"description": "High-throughput DOOH delivery & tracking API built with pure node:http and Redis",
	"main": "dist/modules/Core/server.js",
	"type": "module",
	"scripts": {
		"build": "tsc",
		"start": "node dist/modules/Core/server.js",
